<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  note 模块的跨表检索语句。

  为什么只有几个方法却单独开一份 XML：§1.1 约定单表 CRUD 走 MyBatis-Plus（BaseMapper），
  多表 JOIN 走 XML。本文件目前只有详情接口在用，列表 / 搜索随后续切片加进来。

  为什么全部是 INNER JOIN：这五条连接关系在建表语句里都有外键约束兜着——
  note.course_id / note.uploader_id 非空且各自指向 course / user，user.college_id 非空指向 college，
  note_file.note_id 上还有 uk_note_id 唯一键。也就是说「连接不上」这种情形在库里不可能出现，
  用 LEFT JOIN 反而会把数据损坏伪装成「某一列恰好为 null」，让问题更难发现。
-->
<mapper namespace="com.wlf.note.NoteMapper">

    <!--
      详情主干：五张 to-one 的表一次连接出一行。

      别名是必需的，不是风格问题：note / note_file / course / user / college 每张都有 id 列，
      course 与 college 都有 name 列。不显式改名的话，MyBatis 按列名回填时后出现的会覆盖先出现的，
      而 mapUnderscoreToCamelCase 会把 course_id / college_name 这类别名再转成驼峰属性。

      这里刻意不筛 status：已下架的笔记也要能查出来（§4.1 的详情页要渲染「已下架」提示），
      状态该怎么用是 Service 的事。
    -->
    <select id="selectDetail" resultType="com.wlf.note.NoteDetailRow">
        SELECT n.id,
               n.title,
               n.summary,
               n.teacher,
               n.status,
               n.view_count,
               n.download_count,
               n.favorite_count,
               n.created_at,
               n.updated_at,
               f.original_name,
               f.size,
               f.content_type,
               c.id   AS course_id,
               c.name AS course_name,
               u.id   AS uploader_id,
               u.nickname,
               u.avatar,
               g.name AS college_name
        FROM note n
                 JOIN note_file f ON f.note_id = n.id
                 JOIN course c ON c.id = n.course_id
                 JOIN `user` u ON u.id = n.uploader_id
                 JOIN college g ON g.id = u.college_id
        WHERE n.id = #{id}
    </select>

    <!--
      标签：与笔记是 to-many，所以不并进主干——并进去就是「有几个标签就几行」，
      note 那十几列跟着重复，取回来还要靠 <collection> 折叠。

      排序按 tag.id 升序：note_tag 上只有 (note_id, tag_id) 两列，没有「第几个标签」这种
      顺序信息，上传时用户敲的顺序留不下来。id 升序至少是确定的，也与 TagService#list
      的排序口径一致。按 name 排没有意义——默认排序规则对中文是按 Unicode 码点而非拼音。
    -->
    <select id="selectTagRefs" resultType="com.wlf.catalog.dto.TagResponse">
        SELECT t.id,
               t.name
        FROM note_tag nt
                 JOIN tag t ON t.id = nt.tag_id
        WHERE nt.note_id = #{noteId}
        ORDER BY t.id
    </select>

    <!--
      列表 / 搜索主干。与详情那条最大的区别有两个：

      ① 只出 ONLINE（§4.1：列表/搜索对 OFFLINE、DELETED 不可见），且不 JOIN note_file——
         列表项不带文件信息，那是详情页才有的东西。

      ② 标签不并进来。它与笔记是 to-many，一旦 JOIN 进一条带 LIMIT 的语句，
         LIMIT 切的就是 JOIN 之后的行：一篇带 3 个标签的笔记会占掉 3 个名额，
         一页 20 条实际只回来七八篇，甚至某篇笔记在页边界上被切成半条。
         这个错误是静默的——返回的条数「看起来只是少了一点」。标签另起一条 IN 查询
         （selectTagRefsByNoteIds），在 Service 里按 noteId 装配。

      注意区分：按标签**筛选**用的 JOIN（下面那个 <if>）是安全的，因为它带着
       tag_id = ? 的等值条件，而 note_tag 的主键是 (note_id, tag_id)，每篇笔记至多匹配一行。
       危险的是「把每篇笔记的全部标签拉进来」，那才是一对多展开。
    -->
    <select id="selectListPage" resultType="com.wlf.note.NoteListRow">
        SELECT n.id,
               n.title,
               n.view_count,
               n.download_count,
               n.favorite_count,
               n.updated_at,
               c.id   AS course_id,
               c.name AS course_name,
               u.id   AS uploader_id,
               u.nickname,
               u.avatar,
               g.name AS college_name
        FROM note n
                 JOIN course c ON c.id = n.course_id
                 JOIN `user` u ON u.id = n.uploader_id
                 JOIN college g ON g.id = u.college_id
        <if test="tagId != null">
                 JOIN note_tag nt ON nt.note_id = n.id AND nt.tag_id = #{tagId}
        </if>
        WHERE n.status = #{status}
        <if test="courseId != null">
            AND n.course_id = #{courseId}
        </if>
        <!--
          排序走 <choose> + 写死的字面量，全程不出现 ${}。ORDER BY 没法用 #{} 参数化，
          只能拼接字符串，所以排序键必须来自这份白名单，绝不能是用户传来的字面量。
          分支按 sort 的字符串取值（NoteListQuery.Sort 的 name()）来选。

          每个排序都带 n.id DESC 作次级键，不是洁癖：view_count / download_count
          在大面积并列时（新站全是 0），只按它排的话 MySQL 不保证同分行的相对顺序稳定，
          翻页会看到重复或漏掉的笔记。次级键定死，顺序才是确定的。

          另：InnoDB 的二级索引叶子节点隐含主键 id，所以 (status, updated_at) 这类索引
          可以直接支撑「status 等值 + updated_at DESC, id DESC」的倒扫，不需要 filesort。
        -->
        <choose>
            <when test="sort == 'HOT_VIEW'">
                ORDER BY n.view_count DESC, n.id DESC
            </when>
            <when test="sort == 'HOT_DOWNLOAD'">
                ORDER BY n.download_count DESC, n.id DESC
            </when>
            <otherwise>
                ORDER BY n.updated_at DESC, n.id DESC
            </otherwise>
        </choose>
    </select>

    <!--
      「我的上传」主干。见 §5.4、§4.1。

      ① DELETED 无条件排除——本列表的定义就是「我还留着的笔记」。§4.1 的表里「我的上传」
         这一列对 DELETED 现在是「不可见」（此前是「可见并标注」，已按实测口径改过）。
         排除要落在 SQL 而不是 Service 里过滤：不然 total 会把已删除的也数进去，
         前端会算出一堆点进去是空的页。要排除的状态由调用方传，不写死字面量。

      ② 不 JOIN user / college。上传者恒等于调用方自己，昵称 / 头像 / 学院三项都不返回，
         所以这条比 selectListPage 还少两次 JOIN。注意这跟「上传者信息该不该给」是两件事：
         公开列表给，是因为那里看的是别人的笔记；这里给就是把自己再报一遍。

      ③ 标签不并进来，理由同 selectListPage：它与笔记是 to-many，JOIN 进带 LIMIT 的语句
         会让 LIMIT 切在 JOIN 之后的行上。另起一条 IN 查询（selectTagRefsByNoteIds）装配。

      ④ 排序 created_at DESC + id DESC。
         次级键不是洁癖：created_at 是秒精度的 DATETIME，批量上传或脚本造数据时同秒并列很常见，
         没有确定的次级键时翻页会看到重复或漏掉的笔记（与公开列表那三条排序同规矩）。

         索引：idx_uploader_status (uploader_id, status) 能吃下两个 WHERE 条件，
         但 status 是不等值、且 created_at 不在该索引里，所以这条排序要走 filesort。
         眼下不加索引——单个用户的上传数是几十量级，而分页深度上限（Paging.MAX_PAGE_DEPTH）
         把最坏情况也兜住了；本项目的习惯是加索引先有 EXPLAIN 实测证据（§3.3 那三条排序键即如此），
         没有测量就加，只会多一处需要维护却没人知道它管不管用的东西。

      ⑤ 用 != 而不是 <>：本文件是 XML，字面量的 '<' 是非法字符，写成 <> 得转义成 &lt;&gt;，
         反而更难读。MySQL 里两者完全等价，status 列又是 NOT NULL，不存在 NULL 比较的歧义。
    -->
    <select id="selectMyNotePage" resultType="com.wlf.note.MyNoteRow">
        SELECT n.id,
               n.status,
               n.title,
               n.view_count,
               n.download_count,
               n.favorite_count,
               n.created_at,
               c.id   AS course_id,
               c.name AS course_name
        FROM note n
                 JOIN course c ON c.id = n.course_id
        WHERE n.uploader_id = #{uploaderId}
          AND n.status != #{excludedStatus}
        ORDER BY n.created_at DESC, n.id DESC
    </select>

    <!--
      一整页笔记的标签，一次取回（N+1 的解法）。

      调用方保证 noteIds 非空：IN () 是语法错误，空页应当在 Service 里直接短路。
    -->
    <select id="selectTagRefsByNoteIds" resultType="com.wlf.note.NoteTagRef">
        SELECT nt.note_id,
               t.id   AS tag_id,
               t.name AS tag_name
        FROM note_tag nt
                 JOIN tag t ON t.id = nt.tag_id
        WHERE nt.note_id IN
        <foreach collection="noteIds" item="noteId" open="(" separator="," close=")">
            #{noteId}
        </foreach>
        ORDER BY nt.note_id, t.id
    </select>

    <!--
      归属 + 附件位置，服务 ai 模块的编辑场景（§5.8）。

      与 selectOwnershipForUpdate 的唯一差别是没有 FOR UPDATE，理由见 NoteFileOwnershipRow
      与 NoteMapper#selectFileOwnership：ai 只读不写，读完之后要做的是「读 OSS → 调模型」，
      几秒到几十秒里并不需要保护这一行不变。

      JOIN note_file 而不是分两次查：note_file.note_id 上有 uk_note_id 唯一键，
      连接不出多余的行，一次往返就能拿全四列。这两张表也都有外键兜着，用 INNER JOIN
      不会意外丢行（同 selectDetail 的理由）。
    -->
    <select id="selectFileOwnership" resultType="com.wlf.note.NoteFileOwnershipRow">
        SELECT n.uploader_id  AS uploader_id,
               n.status       AS status,
               f.storage_key  AS storage_key,
               f.size,
               f.content_type AS content_type
        FROM note n
                 JOIN note_file f ON f.note_id = n.id
        WHERE n.id = #{id}
    </select>

</mapper>
