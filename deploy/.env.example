# 复制为 deploy/.env 后填强密码，并 chmod 600。
# 只服务 docker-compose.prod.yml；应用自身的变量在 /etc/jotang/jotang.env，两处不要混。
# .env 不进仓库（根 .gitignore 已忽略）。
#
# MYSQL_USER / MYSQL_PASSWORD 必须与 /etc/jotang/jotang.env 里的
# DB_USERNAME / DB_PASSWORD 一致，否则应用连不上库。

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=jotang_note
MYSQL_USER=jotang
MYSQL_PASSWORD=change-me

RABBITMQ_USER=jotang
RABBITMQ_PASSWORD=change-me

REDIS_PASSWORD=change-me
