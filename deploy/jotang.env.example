# 应用环境变量。装到 /etc/jotang/jotang.env，chmod 600、属主 root。
# systemd 通过 EnvironmentFile= 读取；Spring Boot 本身只读环境变量，不读这个文件。
#
# 格式是裸的 KEY=VALUE：不要写 export、不要加引号、行尾不要写注释（systemd 会把它们当成值的一部分）。
# 变量名与含义见 src/main/resources/application.yaml。

# ── 必填：缺任意一项，应用启动即失败 ──────────────────────────────
# 用 openssl rand -base64 48 新生成，不要复用本机 application-local.yaml 里那个。
# 注意 JwtTokenProvider 要求 Base64 解码后 ≥256 位。
JWT_SECRET=
JOTANG_OSS_ACCESS_KEY_ID=
JOTANG_OSS_ACCESS_KEY_SECRET=

# ── 生产必须覆盖：默认值都指向本机，不覆盖连不上 ──────────────────
# MySQL 是 docker-compose 里的容器，经端口映射暴露在 127.0.0.1:3306。
# USERNAME / PASSWORD 必须与 deploy/.env 里的 MYSQL_USER / MYSQL_PASSWORD 一致。
# 表结构与种子数据不用手工导入：spring.sql.init.mode=always，脚本幂等，首次启动自动执行。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jotang_note
DB_USERNAME=jotang
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=jotang
RABBITMQ_PASSWORD=

# 重置邮件里链接的域名前缀，后端只在后面拼 ?token=...
# 默认值是 localhost:5173，不改成公网地址的话用户点开打不开。
JOTANG_MAIL_RESET_LINK_BASE=http://<ECS 公网 IP>/reset-password

# QQ 邮箱的 SMTP 授权码，不是登录密码；授权码错了是 535。
# FROM 必须与 USERNAME 一致，否则 QQ 直接拒收（默认取 USERNAME，留空即可）。
JOTANG_MAIL_HOST=smtp.qq.com
JOTANG_MAIL_PORT=465
JOTANG_MAIL_USERNAME=
JOTANG_MAIL_PASSWORD=

# ── 按部署环境调整 ────────────────────────────────────────────────
# 只允许 Nginx 从本机反代进来，8080 不对外暴露
SERVER_ADDRESS=127.0.0.1
# 上传中转目录：单文件可达 100MB，别放在系统盘的小分区上
JOTANG_UPLOAD_TMP=/var/lib/jotang/upload-tmp

# 留空也能正常启动，只有真去调用 AI 时才报 50300
JOTANG_AI_API_KEY=

# 发信与补偿删除走 MQ。两项的默认值本来就是 queue，这里显式写出便于确认。
JOTANG_MAIL_MODE=queue
JOTANG_PURGE_MODE=queue

# OSS：ECS 与 OSS 同在成都，走内网 Endpoint（流量免费、不占公网带宽）。
# 换到非成都地域时必须把第一行改成公网域名 oss-cn-chengdu.aliyuncs.com，否则内网域名解析不了。
JOTANG_OSS_ENDPOINT_SERVER=oss-cn-chengdu-internal.aliyuncs.com
JOTANG_OSS_ENDPOINT_BROWSER=oss-cn-chengdu.aliyuncs.com
JOTANG_OSS_BUCKET_NOTE=jotang-note
JOTANG_OSS_BUCKET_AVATAR=jotang-avatar
