# 复制为 .env 后按需修改。.env 不进仓库（见 .gitignore）。
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me

# 需与各服务 application-local.yaml 里的 spring.datasource.password 一致
MYSQL_ROOT_PASSWORD=change-me

# Nacos 鉴权：token 必须是 Base64（解码后 >= 32 字节）
NACOS_AUTH_TOKEN=change-me-base64-32-bytes
NACOS_AUTH_IDENTITY_KEY=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me
