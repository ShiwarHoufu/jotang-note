<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  favorite 模块的跨表检索语句。

  全部是 INNER JOIN：连接键都有外键兜着——favorite.note_id → note.id、note.course_id → course.id。
  上传者资料不在这里 JOIN，走 user-service。
-->
<mapper namespace="com.wlf.note.infrastructure.persistence.FavoriteMapper">

    <!--
      我的收藏的一页。

      不筛 n.status。正常项、OFFLINE、DELETED三种状态都取回来交给 Service 渲染：

      标签不并进来：它与笔记是 to-many，一旦 JOIN 进带 LIMIT 的语句，LIMIT 切的就是
      JOIN 之后的行——一篇带 3 个标签的笔记会占掉 3 个名额，标签另起一条 IN 查询批量取回，在 Service 里按 noteId 装配。
      同理，note_tag也不能作为筛选条件出现。

      排序：f.created_at DESC 是主键，f.id DESC 做次级键。
      created_at 是秒精度的 DATETIME，同一秒内连收几篇就会并列，没有次级键时翻页会看到重复或漏掉的项。
    -->
    <select id="selectFavoritePage" resultType="com.wlf.note.application.favorite.dto.FavoriteItemRow">
        SELECT f.note_id,
               f.created_at AS favorited_at,
               n.status,
               n.title,
               n.view_count,
               n.download_count,
               n.favorite_count,
               n.updated_at,
               c.id   AS course_id,
               c.name AS course_name,
               n.uploader_id AS uploader_id
        FROM favorite f
                 JOIN note n ON n.id = f.note_id
                 JOIN course c ON c.id = n.course_id
        WHERE f.user_id = #{userId}
        ORDER BY f.created_at DESC, f.id DESC
    </select>

</mapper>
